/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 2000,
    "subrequests": 20,
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/v1/payment/challenge",
      "/api/v1/payment/redeem-project-submission",
      "/api/v1/submissions",
    ],
  },
  "routes": [
    {
      "pattern": "dogafincan.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false,
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.05,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true,
    },
  },
  "ratelimits": [
    {
      "name": "PORTFOLIO_PUBLIC_CLIENT_LIMITER",
      "namespace_id": "2026072931",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
    {
      "name": "PORTFOLIO_PUBLIC_LOCATION_LIMITER",
      "namespace_id": "2026072932",
      "simple": {
        "limit": 300,
        "period": 60,
      },
    },
    {
      "name": "PORTFOLIO_PAID_CLIENT_LIMITER",
      "namespace_id": "2026072933",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
    {
      "name": "PORTFOLIO_PAID_LOCATION_LIMITER",
      "namespace_id": "2026072934",
      "simple": {
        "limit": 100,
        "period": 60,
      },
    },
  ],
  "services": [
    {
      "binding": "REGISTRY_PUBLIC_GATEWAY",
      "service": "doji-registry",
    },
  ],
  "upload_source_maps": true,
}
