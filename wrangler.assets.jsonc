{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-05-22",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "dogafincan.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false,
    },
  ],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "404-page",
  },
}
